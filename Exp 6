import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from statsmodels.tsa.seasonal import seasonal_decompose
from statsmodels.tsa.statespace.sarimax import SARIMAX
from sklearn.metrics import mean_absolute_error

np.random.seed(42)
dates = pd.date_range(start="2026-01-01", periods=120, freq="D")

trend = np.linspace(1000, 2500, 120)
weekly_pattern = np.array([200, 300, 250, 150, -100, -500, -400]) # Mon-Sun
seasonality = np.array([weekly_pattern[d.weekday()] for d in dates])
noise = np.random.normal(0, 80, 120)

df = pd.DataFrame({"Traffic": trend + seasonality + noise}, index=dates)

decomposition = seasonal_decompose(df["Traffic"], model="additive", period=7)

df["Trend"] = decomposition.trend
df["Seasonal"] = decomposition.seasonal
df["Residual"] = decomposition.resid
